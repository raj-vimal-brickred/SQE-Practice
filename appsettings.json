{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SQE_Practice.Middleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqeDatabase": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=dbo_SQE;Integrated Security=True"
  },
  "RequestMiddleware": {
    "SlowRequestThresholdMs": 1000,
    "CaptureBody": false,
    "MaxBodyBytes": 4096,
    "IgnoredPaths": [
      "/swagger",
      "/health",
      "/favicon.ico"
    ]
  }
}
